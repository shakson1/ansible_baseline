#!/bin/bash

# Network monitoring script
# Generated by Ansible baseline role

LOG_FILE="/var/log/monitoring/network.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

# Create log directory if it doesn't exist
mkdir -p /var/log/monitoring

# Function to log messages
log_message() {
    echo "[$DATE] $1" >> "$LOG_FILE"
}

# Check network interfaces
ip link show | grep -E "^[0-9]+:" | awk -F: '{print $2}' | sed 's/ //' | while read interface;
do
    if [ -n "$interface" ] && [ "$interface" != "lo" ]; then
        # Check if interface is up
        if ! ip link show "$interface" | grep -q "UP"; then
            log_message "WARNING: Network interface $interface is down"
        fi
        
        # Check for errors on interface
        if command -v ethtool >/dev/null 2>&1; then
            errors=$(ethtool -S "$interface" 2>/dev/null | grep -E "(rx_errors|tx_errors)" | awk '{sum+=$2} END {print sum}')
            if [ -n "$errors" ] && [ "$errors" -gt 0 ]; then
                log_message "WARNING: Network interface $interface has $errors errors"
            fi
        fi
    fi
done

# Check network connectivity
if command -v ping >/dev/null 2>&1; then
    # Test connectivity to common DNS servers
    dns_servers=("8.8.8.8" "1.1.1.1" "208.67.222.222")
    for dns in "${dns_servers[@]}"; do
        if ! ping -c 1 -W 5 "$dns" >/dev/null 2>&1; then
            log_message "WARNING: Cannot reach DNS server $dns"
        fi
    done
fi

# Check for high network usage (if nethogs is available)
if command -v nethogs >/dev/null 2>&1; then
    # Get network usage for the last 5 seconds
    nethogs_output=$(timeout 5s nethogs -t 2>/dev/null | tail -n +3)
    if [ -n "$nethogs_output" ]; then
        echo "$nethogs_output" | while read line; do
            if [ -n "$line" ] && [[ "$line" != *"Refreshing"* ]]; then
                usage=$(echo "$line" | awk '{print $3}' | sed 's/KB//')
                if [ -n "$usage" ] && (( $(echo "$usage > 1000" | bc -l) )); then
                    process=$(echo "$line" | awk '{print $1}')
                    log_message "INFO: High network usage by $process: ${usage}KB"
                fi
            fi
        done
    fi
fi

# Check for network errors in dmesg
if command -v dmesg >/dev/null 2>&1; then
    net_errors=$(dmesg | grep -i "network\|ethernet\|wifi\|wireless" | grep -i "error\|fail\|down" | tail -5 | wc -l)
    if [ "$net_errors" -gt 0 ]; then
        log_message "WARNING: Found $net_errors recent network errors in dmesg"
    fi
fi

# Check for failed network services
network_services=("sshd" "{{ baseline_firewall_service }}")
for service in "${network_services[@]}"; do
    if ! systemctl is-active --quiet "$service"; then
        log_message "ERROR: Network service $service is not running"
    fi
done

# Check for unusual network connections (if netstat is available)
if command -v netstat >/dev/null 2>&1; then
    # Count established connections
    established_conns=$(netstat -an | grep ESTABLISHED | wc -l)
    if [ "$established_conns" -gt 1000 ]; then
        log_message "WARNING: High number of established connections: $established_conns"
    fi
    
    # Check for listening ports
    listening_ports=$(netstat -tlnp | grep LISTEN | wc -l)
    if [ "$listening_ports" -gt 50 ]; then
        log_message "WARNING: High number of listening ports: $listening_ports"
    fi
fi

# Check for network interface statistics
if command -v cat >/dev/null 2>&1; then
    for interface in /sys/class/net/*; do
        if [ -d "$interface" ] && [ "$(basename "$interface")" != "lo" ]; then
            interface_name=$(basename "$interface")
            rx_errors=$(cat "$interface/statistics/rx_errors" 2>/dev/null || echo "0")
            tx_errors=$(cat "$interface/statistics/tx_errors" 2>/dev/null || echo "0")
            total_errors=$((rx_errors + tx_errors))
            
            if [ "$total_errors" -gt 100 ]; then
                log_message "WARNING: Network interface $interface_name has $total_errors errors (rx: $rx_errors, tx: $tx_errors)"
            fi
        fi
    done
fi

# Rotate log file if it gets too large (over 5MB)
if [ -f "$LOG_FILE" ] && [ $(stat -c%s "$LOG_FILE") -gt 5242880 ]; then
    mv "$LOG_FILE" "${LOG_FILE}.old"
    gzip "${LOG_FILE}.old" 2>/dev/null
fi 