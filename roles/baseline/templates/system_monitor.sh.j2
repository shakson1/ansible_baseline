#!/bin/bash

# System monitoring script
# Generated by Ansible baseline role

LOG_FILE="/var/log/monitoring/system.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

# Create log directory if it doesn't exist
mkdir -p /var/log/monitoring

# Function to log messages
log_message() {
    echo "[$DATE] $1" >> "$LOG_FILE"
}

# Check CPU usage
cpu_usage=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1)
if (( $(echo "$cpu_usage > 80" | bc -l) )); then
    log_message "WARNING: High CPU usage detected: ${cpu_usage}%"
fi

# Check memory usage
memory_usage=$(free | grep Mem | awk '{printf("%.2f", $3/$2 * 100.0)}')
if (( $(echo "$memory_usage > 85" | bc -l) )); then
    log_message "WARNING: High memory usage detected: ${memory_usage}%"
fi

# Check disk usage
df -h | grep -vE '^Filesystem|tmpfs|cdrom' | awk '{print $5 " " $1}' | while read output;
do
    usage=$(echo $output | awk '{print $1}' | cut -d'%' -f1)
    partition=$(echo $output | awk '{print $2}')
    if [ $usage -ge 85 ]; then
        log_message "WARNING: High disk usage on $partition: ${usage}%"
    fi
done

# Check load average
load_avg=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | sed 's/,//')
cpu_cores=$(nproc)
load_threshold=$(echo "$cpu_cores * 0.8" | bc -l)

if (( $(echo "$load_avg > $load_threshold" | bc -l) )); then
    log_message "WARNING: High load average detected: $load_avg (threshold: $load_threshold)"
fi

# Check for critical services
critical_services=("sshd" "{{ baseline_logging_service }}" "{{ baseline_firewall_service }}")
for service in "${critical_services[@]}"; do
    if ! systemctl is-active --quiet "$service"; then
        log_message "ERROR: Critical service $service is not running"
    fi
done

# Check for failed systemd units
failed_units=$(systemctl --failed --no-legend --no-pager | wc -l)
if [ "$failed_units" -gt 0 ]; then
    log_message "WARNING: $failed_units failed systemd units detected"
fi

# Log system uptime
uptime_info=$(uptime -p)
log_message "INFO: System uptime: $uptime_info"

# Rotate log file if it gets too large (over 10MB)
if [ -f "$LOG_FILE" ] && [ $(stat -c%s "$LOG_FILE") -gt 10485760 ]; then
    mv "$LOG_FILE" "${LOG_FILE}.old"
    gzip "${LOG_FILE}.old" 2>/dev/null
fi 