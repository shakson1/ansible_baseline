#!/bin/bash

# Disk monitoring script
# Generated by Ansible baseline role

LOG_FILE="/var/log/monitoring/disk.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

# Create log directory if it doesn't exist
mkdir -p /var/log/monitoring

# Function to log messages
log_message() {
    echo "[$DATE] $1" >> "$LOG_FILE"
}

# Check disk usage
df -h | grep -vE '^Filesystem|tmpfs|cdrom' | awk '{print $5 " " $1 " " $2 " " $3 " " $4}' | while read output;
do
    usage=$(echo $output | awk '{print $1}' | cut -d'%' -f1)
    partition=$(echo $output | awk '{print $2}')
    total=$(echo $output | awk '{print $3}')
    used=$(echo $output | awk '{print $4}')
    available=$(echo $output | awk '{print $5}')
    
    if [ $usage -ge 90 ]; then
        log_message "CRITICAL: Disk usage on $partition is ${usage}% (${used}/${total} used, ${available} available)"
    elif [ $usage -ge 80 ]; then
        log_message "WARNING: Disk usage on $partition is ${usage}% (${used}/${total} used, ${available} available)"
    fi
done

# Check inode usage
df -i | grep -vE '^Filesystem|tmpfs|cdrom' | awk '{print $5 " " $1}' | while read output;
do
    inode_usage=$(echo $output | awk '{print $1}' | cut -d'%' -f1)
    partition=$(echo $output | awk '{print $2}')
    
    if [ $inode_usage -ge 90 ]; then
        log_message "CRITICAL: Inode usage on $partition is ${inode_usage}%"
    elif [ $inode_usage -ge 80 ]; then
        log_message "WARNING: Inode usage on $partition is ${inode_usage}%"
    fi
done

# Check for large files in /tmp (over 100MB)
large_files=$(find /tmp -type f -size +100M 2>/dev/null | wc -l)
if [ "$large_files" -gt 0 ]; then
    log_message "WARNING: Found $large_files large files (>100MB) in /tmp"
fi

# Check for large files in /var/log (over 50MB)
large_log_files=$(find /var/log -type f -size +50M 2>/dev/null | wc -l)
if [ "$large_log_files" -gt 0 ]; then
    log_message "WARNING: Found $large_log_files large log files (>50MB) in /var/log"
fi

# Check disk I/O statistics (if iostat is available)
if command -v iostat >/dev/null 2>&1; then
    # Get disk I/O stats for the last minute
    iostat_output=$(iostat -x 1 1 2>/dev/null | tail -n +4)
    if [ -n "$iostat_output" ]; then
        echo "$iostat_output" | while read line; do
            if [ -n "$line" ] && [[ "$line" != *"Device"* ]]; then
                device=$(echo "$line" | awk '{print $1}')
                util=$(echo "$line" | awk '{print $NF}')
                if (( $(echo "$util > 80" | bc -l) )); then
                    log_message "WARNING: High disk I/O utilization on $device: ${util}%"
                fi
            fi
        done
    fi
fi

# Check for filesystem errors
if command -v dmesg >/dev/null 2>&1; then
    fs_errors=$(dmesg | grep -i "filesystem\|i/o error\|disk error" | tail -5 | wc -l)
    if [ "$fs_errors" -gt 0 ]; then
        log_message "WARNING: Found $fs_errors recent filesystem/disk errors in dmesg"
    fi
fi

# Rotate log file if it gets too large (over 5MB)
if [ -f "$LOG_FILE" ] && [ $(stat -c%s "$LOG_FILE") -gt 5242880 ]; then
    mv "$LOG_FILE" "${LOG_FILE}.old"
    gzip "${LOG_FILE}.old" 2>/dev/null
fi 